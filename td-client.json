{
  "family": "bdget-client",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::471112894346:role/LabRole",
  "taskRoleArn": "arn:aws:iam::471112894346:role/LabRole",
  "containerDefinitions": [{
    "name": "client",
    "image": "curlimages/curl:8.8.0",
    "essential": true,
    "entryPoint": ["sh", "-c"],
    "command": ["while true; do curl -s -o /dev/null http://bdget-app:8080/students; sleep 1; done"],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/bdget",
        "awslogs-region": "us-east-1",
        "awslogs-stream-prefix": "client"
      }
    }
  }]
}
