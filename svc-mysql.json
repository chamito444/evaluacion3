{
  "cluster": "bdget-ecs",
  "serviceName": "mysql",
  "taskDefinition": "bdget-mysql",
  "desiredCount": 1,
  "launchType": "FARGATE",
  "networkConfiguration": {
    "awsvpcConfiguration": {
      "subnets": ["subnet-09ef4a802ae5cfb37", "subnet-032daa8af81a66302"],
      "securityGroups": ["sg-0c8e2b69c34579486"],
      "assignPublicIp": "ENABLED"
    }
  },
  "serviceConnectConfiguration": {
    "enabled": true,
    "namespace": "bdget.local",
    "services": [{
      "portName": "mysql-port",
      "discoveryName": "mysql",
      "clientAliases": [{ "port": 3306, "dnsName": "mysql" }]
    }],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/bdget",
        "awslogs-region": "us-east-1",
        "awslogs-stream-prefix": "sc-mysql"
      }
    }
  }
}
